# Copier ce fichier en ".env" puis remplacer TOUTES les valeurs.
# Générer un secret :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- Docker (docker compose up) ---
POSTGRES_PASSWORD=change-moi
MIGRATOR_DB_PASSWORD=change-moi-aussi
APP_DB_PASSWORD=change-moi-encore
JWT_SECRET=colle-ici-un-secret-aleatoire-de-48-caracteres-minimum
# Prod uniquement (laisser commenté en local) :
# SITE_ADDRESS=mon-domaine.fr
# PUBLIC_ORIGIN=https://mon-domaine.fr

# --- Dev local (npm run dev), avec un Postgres local ---
DATABASE_URL="postgresql://pause_app:change-moi-encore@localhost:5432/pause"
MIGRATE_DATABASE_URL="postgresql://pause_migrator:change-moi-aussi@localhost:5432/pause"
APP_ORIGIN="http://localhost:3000"
UPLOAD_DIR="./uploads"
TRUST_PROXY="false"

# --- Assistant IA Gemini (facultatif) ---
# En prod (VM Google Cloud) : VERTEX_PROJECT=<id du projet> → Gemini via Vertex AI, SANS clé.
# En dev avec Vertex : VERTEX_PROJECT=... et VERTEX_ACCESS_TOKEN=$(gcloud auth print-access-token) (valable 1 h)
VERTEX_PROJECT=
# Sinon, clé AI Studio :
# Clé gratuite : https://aistudio.google.com/apikey (bouton « Create API key »)
# Sans clé, l'assistant répond quand même (mode local, règles simples).
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Garde-fous de quota (appels Gemini par jour)
AI_DAILY_LIMIT_PER_USER=30
AI_DAILY_LIMIT_GLOBAL=500
