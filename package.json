{
  "name": "pause",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "INTEGRATION=1 vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:rollback": "tsx db/rollback.ts",
    "db:seed": "tsx db/seed.ts",
    "audit": "npm audit --omit=dev --audit-level=high",
    "security:test": "node scripts/security-test.mjs",
    "security:test:alain": "bash scripts/security-test.sh",
    "contract:check": "node scripts/contract-check.mjs",
    "contract:lint": "npx --yes @stoplight/spectral-cli@6.15.0 lint openapi.yaml --fail-severity=error"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "leaflet": "1.9.4",
    "lucide-react": "1.48.0",
    "maplibre-gl": "6.11.2",
    "next": "15.5.27",
    "opening_hours": "3.15.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.30",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "vite": "7.3.7"
  }
}
